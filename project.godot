[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[rendering]

occlusion_culling/use_occlusion_culling=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/atlas_16_bits=false
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=false
openxr/enabled.windows=true
openxr/default_action_map="res://scripts/vr/museum_actions.tres"
openxr/reference_space=1
openxr/startup_alert=false
shaders/enabled=true
