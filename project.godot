; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Museum of U"
config/icon="res://assets/ui/museum-icon.png"
config/macos_native_icon="res://assets/ui/museum-icon.icns"
config/windows_native_icon="res://assets/ui/museum-icon.ico"
boot_splash/image="res://assets/ui/museum-logo.png"
boot_splash/bg_color=Color(0.012, 0.235, 0.176, 1)
boot_splash/fullsize=false
config/use_custom_user_dir=true
config/custom_user_dir_name="Photo Museum"
run/main_scene="res://scenes/ui/application.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://assets/audio/museum_buses.tres"

[autoload]

LaunchSettings="*res://scripts/settings/game_settings.gd"
GameInput="*res://scripts/player/input_router.gd"
RunMemory="*res://scripts/session/run_memory.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

